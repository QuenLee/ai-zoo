---
layout: '../layouts/Layout.astro'
title: 'AI 动物园 | AI Zoo'
description: 'AI 工具大揭秘！像逛动物园一样轻松学会 AI。'
---

import { generateImageUrl, getAnimalCoverPrompt } from '../lib/imageGen';

// 定义动物列表
const animals = [
  {
    id: 'llm',
    name: 'LLM (大语言模型)',
    icon: '🦁',
    animalType: 'lion',
    description: '博学但爱吹牛的“超级鹦鹉”',
    difficulty: '⭐⭐',
    tags: ['AI 入门', '文本生成'],
  },
  {
    id: 'midjourney',
    name: 'Midjourney',
    icon: '🦚',
    animalType: 'peacock',
    description: '绚丽多彩的视觉艺术家',
    difficulty: '⭐⭐⭐',
    tags: ['图像生成', '设计'],
  },
  {
    id: 'notion-ai',
    name: 'Notion AI',
    icon: '🐜',
    animalType: 'ant',
    description: '勤勤恳恳的整理大师',
    difficulty: '⭐',
    tags: ['效率工具', '笔记'],
  },
];

// 生成封面图 URL (使用你的 API)
const getCoverUrl = (animalType: string) => {
  const prompt = getAnimalCoverPrompt(animalType, 'cyberpunk');
  return generateImageUrl(prompt, 800, 600, 123); // 固定 seed 保证一致性
};
---

<div class="min-h-screen py-12 px-4">
  <!-- 标题区 -->
  <div class="text-center mb-16">
    <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 glow-text drop-shadow-lg">
      🦁 欢迎来到 AI 动物园
    </h1>
    <p class="text-xl md:text-2xl text-white/90 max-w-2xl mx-auto leading-relaxed">
      别被 AI 吓倒！在这里，每个 AI 工具都是一只动物。<br/>
      LLM 是爱吹牛的狮子 🦁，Midjourney 是绚丽的孔雀 🦚，Notion AI 是勤劳的蚂蚁 🐜...<br/>
      快来认识它们，学会驯服它们，让它们为你打工！
    </p>
  </div>

  <!-- 动物卡片网格 -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
    {animals.map((animal) => (
      <a 
        href={`/docs/${animal.id}`} 
        class="group block h-full"
      >
        <div class="glass-card animal-card h-full flex flex-col relative overflow-hidden">
          {/* 背景图：AI 生成 */}
          <div class="absolute inset-0 z-0">
            <img 
              src={getCoverUrl(animal.animalType)} 
              alt={animal.name}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            {/* 遮罩层：让文字更清晰 */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
          </div>

          {/* 内容区 */}
          <div class="relative z-10 p-6 flex flex-col h-full justify-end">
            <div class="text-5xl mb-4 transform group-hover:scale-110 transition-transform duration-300">
              {animal.icon}
            </div>
            <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-yellow-400 transition-colors">
              {animal.name}
            </h3>
            <p class="text-white/80 mb-4 line-clamp-2">
              {animal.description}
            </p>
            
            <div class="flex flex-wrap gap-2 mb-4">
              {animal.tags.map((tag) => (
                <span class="px-3 py-1 text-xs font-semibold bg-white/20 backdrop-blur-sm rounded-full text-white border border-white/30">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between text-white/90 text-sm">
              <span>饲养难度：{animal.difficulty}</span>
              <span class="flex items-center gap-2 group-hover:gap-3 transition-all">
                查看档案 
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>

  {/* 底部 CTA */}
  <div class="text-center mt-16">
    <p class="text-white/80 mb-6">
      更多神秘动物正在入驻中... 🦒🦓🦊
    </p>
  </div>
</div>
