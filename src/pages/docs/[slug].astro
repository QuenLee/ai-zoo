---
// src/pages/docs/[slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateImageUrl, getAnimalCoverPrompt } from '../../lib/imageGen';

export async function getStaticPaths() {
  const posts = await getCollection('docs');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const coverUrl = generateImageUrl(post.data.coverPrompt || 'AI brain', 1200, 630, 456);
---

<BaseLayout title={`${post.data.title} | AI 系列教程`} description={post.data.description} lang={post.data.lang || 'zh-CN'}>
  
  <!-- 文章头图 -->
  <div class="relative h-64 md:h-96 w-full rounded-2xl overflow-hidden mb-8 shadow-2xl group">
    <img 
      src={coverUrl} 
      alt={post.data.title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
    <div class="absolute bottom-0 left-0 p-6 md:p-10 text-white max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-bold mb-4 drop-shadow-lg">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap gap-3">
        {post.data.tags?.map((tag) => (
          <span class="px-4 py-1.5 text-sm font-semibold bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- 文章内容 -->
  <article class="prose">
    <Content />
  </article>

  <!-- 底部导航 (追剧体验) -->
  <div class="max-w-3xl mx-auto mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 flex justify-between">
    <a href="/" class="text-blue-600 hover:underline">← 返回系列首页</a>
    <a href="/docs/prompt" class="text-blue-600 hover:underline flex items-center gap-1">
      下一章：提示词工程 →
    </a>
  </div>

</BaseLayout>
