---
// src/pages/docs/[slug].astro
import { getCollection } from 'astro:content';
import { generateImageUrl, getAnimalCoverPrompt } from '../../lib/imageGen';

export async function getStaticPaths() {
  const posts = await getCollection('docs');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 获取封面图
const animalType = post.data.animalType || 'default';
const coverPrompt = post.data.coverPrompt || getAnimalCoverPrompt(animalType, 'cyberpunk');
const coverUrl = generateImageUrl(coverPrompt, 1200, 630, 456);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | AI 动物园</title>
    <meta name="description" content={post.data.description} />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:image" content={coverUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen">
    <!-- 导航栏 -->
    <nav class="glass-card mx-4 mt-4 mb-8 p-4 flex items-center justify-between sticky top-4 z-50">
      <a href="/" class="text-2xl font-bold text-white hover:text-yellow-400 transition-colors">
        🦁 AI 动物园
      </a>
      <div class="flex gap-4">
        <a href="/" class="text-white/90 hover:text-white font-medium transition-colors">
          返回园区
        </a>
      </div>
    </nav>

    <!-- 文章主体 -->
    <article class="max-w-4xl mx-auto px-4 pb-16">
      <!-- 封面头图 -->
      <div class="glass-card overflow-hidden mb-8 relative group">
        <img 
          src={coverUrl} 
          alt={post.data.title}
          class="w-full h-[400px] object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8">
          <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 drop-shadow-lg">
            {post.data.icon || '🦁'} {post.data.title}
          </h1>
          <div class="flex flex-wrap gap-3">
            {post.data.tags?.map((tag: string) => (
              <span class="px-4 py-1.5 text-sm font-semibold bg-yellow-500/90 text-black rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- 内容区 -->
      <div class="glass-card p-8 md:p-12">
        <Content />
      </div>

      <!-- 底部：AI 生成提示 -->
      <div class="mt-8 text-center text-white/60 text-sm">
        <p>✨ 本文封面由 AI 实时生成，基于提示词："{coverPrompt}"</p>
      </div>
    </article>
  </body>
</html>

<style is:global>
  /* 文章内容样式优化 */
  .prose {
    @apply text-white/90 leading-relaxed;
  }
  .prose h2 {
    @apply text-3xl font-bold text-white mt-12 mb-6 border-b border-white/20 pb-2;
  }
  .prose h3 {
    @apply text-2xl font-semibold text-white mt-8 mb-4;
  }
  .prose p {
    @apply mb-4 text-lg;
  }
  .prose ul, .prose ol {
    @apply mb-6 ml-6 list-disc list-inside text-lg;
  }
  .prose blockquote {
    @apply border-l-4 border-yellow-500 bg-white/10 p-4 rounded-r-lg my-6 text-white italic;
  }
  .prose pre {
    @apply bg-gray-900/80 rounded-lg p-4 my-6 overflow-x-auto border border-white/10;
  }
  .prose code {
    @apply bg-white/20 px-2 py-1 rounded text-sm font-mono text-yellow-300;
  }
  .prose pre code {
    @apply bg-transparent p-0 text-white;
  }
</style>
